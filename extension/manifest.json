{
  "manifest_version": 3,
  "name": "Agent Demo Recorder",
  "version": "1.0.0",
  "description": "Records manual browser actions for the agent demo.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://valmart-ecru.vercel.app/*",
    "https://arco-nine.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Recorder"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://valmart-ecru.vercel.app/*",
        "https://arco-nine.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}   